# hl-budget-backend configuration (contracts/deployment.md). Copy to .env.local for local runs:
#   cp .env.example .env.local
# The `local` profile imports .env.local; in the cluster these come from the chart and Vault.
# Placeholder values only. Never commit .env.local.

# Listening port. Not secret. Optional (default 8080).
PORT=8080

# Database. Cluster only: locally docker compose starts Postgres and wires it in, so leave
# these commented out. URL is not secret; username and password are secrets (Vault).
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hl-budget
# SPRING_DATASOURCE_USERNAME=changeme
# SPRING_DATASOURCE_PASSWORD=changeme

# Expected token issuer, with the trailing slash. Not secret. Required.
HLBUDGET_AUTH_ISSUER=https://your-tenant.eu.auth0.com/
# Expected token audience: the HL Budget API identifier in Auth0. Not secret. Required.
HLBUDGET_AUTH_AUDIENCE=https://api.hl-budget.example
# Auth0 signing keys. Not secret. Required.
HLBUDGET_AUTH_JWKSETURI=https://your-tenant.eu.auth0.com/.well-known/jwks.json
# Prefix of the profile claims added by auth0/post-login-profile-claims.js. Not secret. Required.
HLBUDGET_AUTH_CLAIMSNAMESPACE=https://hl-budget/

# The single app currency, ISO 4217. Every amount is in this currency; changing it later does
# not convert stored amounts. Not secret. Required.
HLBUDGET_MONEY_CURRENCY=CAD
# IANA time zone used to decide what "today" is (spendings cannot be dated in the future).
# Not secret. Required.
HLBUDGET_TIMEZONE=America/Toronto
